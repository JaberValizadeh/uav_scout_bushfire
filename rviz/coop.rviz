Panels:
  - Class: rviz/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Fire ground1
        - /Scouts1
      Splitter Ratio: 0.5
    Tree Height: 760
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 22
      Reference Frame: world
      Value: true

    # ---- the incident -------------------------------------------------
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /bushfire/markers
      Name: Fire ground
      Namespaces: {}
      Queue Size: 100
      Value: true

    # What the navigation stack thinks a fire is. This is the display that
    # answers "why did a tender drive through that fire" - if the cloud is
    # missing or in the wrong place, the planner cannot route round it.
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz/PointCloud2
      Color: 255; 90; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Fire as obstacles
      Position Transformer: XYZ
      Queue Size: 10
      Size (m): 0.10000000149011612
      Style: Flat Squares
      Topic: /bushfire/fire_cloud
      Unreliable: false
      Value: true

    # ---- the map the scouts plan on -----------------------------------
    - Alpha: 0.7
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Shared map
      Topic: /map
      Unreliable: false
      Use Timestamp: false
      Value: true

    - Alpha: 0.35
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: scout_0 global costmap
      Topic: /scout_0/move_base/global_costmap/costmap
      Unreliable: false
      Use Timestamp: false
      Value: true

    - Alpha: 0.5
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false
      Name: scout_0 local costmap
      Topic: /scout_0/move_base/local_costmap/costmap
      Unreliable: false
      Use Timestamp: false
      Value: false

    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 25; 255; 100
      Enabled: true
      Head Diameter: 0.0
      Head Length: 0.0
      Length: 0.30000001192092896
      Line Style: Lines
      Line Width: 0.029999999329447746
      Name: scout_0 plan
      Offset: {X: 0, Y: 0, Z: 0}
      Pose Style: None
      Radius: 0.029999999329447746
      Shaft Diameter: 0.10000000149011612
      Shaft Length: 0.10000000149011612
      Topic: /scout_0/move_base/NavfnROS/plan
      Unreliable: false
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 200; 40
      Enabled: true
      Head Diameter: 0.0
      Head Length: 0.0
      Length: 0.30000001192092896
      Line Style: Lines
      Line Width: 0.029999999329447746
      Name: scout_1 plan
      Offset: {X: 0, Y: 0, Z: 0}
      Pose Style: None
      Radius: 0.029999999329447746
      Shaft Diameter: 0.10000000149011612
      Shaft Length: 0.10000000149011612
      Topic: /scout_1/move_base/NavfnROS/plan
      Unreliable: false
      Value: true

    # ---- the vehicles -------------------------------------------------
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links: {All Links Enabled: true, Expand Joint Details: false,
              Expand Link Details: false, Expand Tree: false,
              Link Tree Style: Links in Alphabetic Order}
      Name: uav_0
      Robot Description: /uav_0/robot_description
      TF Prefix: uav_0
      Update Interval: 0
      Value: true
      Visual Enabled: true

    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links: {All Links Enabled: true, Expand Joint Details: false,
              Expand Link Details: false, Expand Tree: false,
              Link Tree Style: Links in Alphabetic Order}
      Name: uav_1
      Robot Description: /uav_1/robot_description
      TF Prefix: uav_1
      Update Interval: 0
      Value: true
      Visual Enabled: true

    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links: {All Links Enabled: true, Expand Joint Details: false,
              Expand Link Details: false, Expand Tree: false,
              Link Tree Style: Links in Alphabetic Order}
      Name: uav_2
      Robot Description: /uav_2/robot_description
      TF Prefix: uav_2
      Update Interval: 0
      Value: true
      Visual Enabled: true

    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links: {All Links Enabled: true, Expand Joint Details: false,
              Expand Link Details: false, Expand Tree: false,
              Link Tree Style: Links in Alphabetic Order}
      Name: Scouts
      Robot Description: /scout_0/robot_description
      TF Prefix: scout_0
      Update Interval: 0
      Value: true
      Visual Enabled: true

    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links: {All Links Enabled: true, Expand Joint Details: false,
              Expand Link Details: false, Expand Tree: false,
              Link Tree Style: Links in Alphabetic Order}
      Name: scout_1
      Robot Description: /scout_1/robot_description
      TF Prefix: scout_1
      Update Interval: 0
      Value: true
      Visual Enabled: true

    # ---- what they can see --------------------------------------------
    # The scouts' scans, which is where the trees come from. The aircraft
    # scans are off by default: three more planes of dots over the same
    # trunks makes the picture harder to read, not easier.
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz/LaserScan
      Color: 0; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: scout_0 scan
      Position Transformer: XYZ
      Queue Size: 10
      Size (m): 0.05
      Style: Flat Squares
      Topic: /scout_0/scan
      Unreliable: false
      Value: true

    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz/LaserScan
      Color: 255; 255; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: scout_1 scan
      Position Transformer: XYZ
      Queue Size: 10
      Size (m): 0.05
      Style: Flat Squares
      Topic: /scout_1/scan
      Unreliable: false
      Value: true

    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz/LaserScan
      Color: 200; 200; 200
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: uav_0 scan
      Position Transformer: XYZ
      Queue Size: 10
      Size (m): 0.04
      Style: Flat Squares
      Topic: /uav_0/scan
      Unreliable: false
      Value: false

    - Class: rviz/TF
      Enabled: false
      Frame Timeout: 15
      Frames: {All Enabled: true}
      Marker Alpha: 1
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree: {}
      Update Interval: 0
      Value: false

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 30
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point: {X: 0, Y: 0, Z: 0}
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.95
      Target Frame: world
      Yaw: 3.9
    Saved: ~
Window Geometry:
  Displays: {collapsed: false}
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1650
  X: 60
  Y: 60
